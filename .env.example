# Every setting in src/labellens/config.py can be overridden as LABELLENS_<NAME>.
LABELLENS_DATA_DIR=data
LABELLENS_OLLAMA_URL=http://127.0.0.1:11434
LABELLENS_EMBED_MODEL=bge-m3

# Generator: local (default) ...
LABELLENS_LLM_PROVIDER=ollama
LABELLENS_LLM_MODEL=llama3.1:8b
# ... or Claude (pip install "labellens[anthropic]"; the SDK reads ANTHROPIC_API_KEY)
# LABELLENS_LLM_PROVIDER=anthropic
# LABELLENS_LLM_MODEL=claude-opus-5-5

# Retrieval
LABELLENS_FINAL_K=6
LABELLENS_RERANK_N=30
LABELLENS_ABSTAIN_THRESHOLD=0.0
# Withhold answers that fail the citation / number checks instead of flagging them
LABELLENS_STRICT_GROUNDING=false
